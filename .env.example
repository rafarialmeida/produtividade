# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings -> API no painel do Supabase).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-public

# Chave pública VAPID para notificações Web Push (gere com: npx web-push generate-vapid-keys).
# Veja o README, seção "Notificações Web Push", para o passo a passo completo.
VITE_VAPID_PUBLIC_KEY=sua-chave-publica-vapid

# Nome da Edge Function que envia os pushes (o Supabase pode gerar um nome aleatório
# se você criou a função pelo painel em vez da CLI). Opcional — padrão "push-sweep".
VITE_PUSH_FUNCTION_NAME=push-sweep
